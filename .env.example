# ---------------------------------------------------------------------------
# LabelCheck configuration. Copy to .env and edit. Every value has a safe
# default, so the app also runs with an empty .env (OCR + templates, no AI).
# ---------------------------------------------------------------------------

# Public domain for HTTPS (used by docker-compose / Caddy). Point its DNS A record
# at your server first. Leave as localhost to try it on your own machine.
DOMAIN=localhost

APP_ENV=production
LOG_LEVEL=INFO

# --- AI label reading + plain-language summaries (optional) -----------------
# auto = use whichever key is set (Anthropic first); or anthropic | gemini | none.
AI_PROVIDER=auto
AI_TIMEOUT_S=60

# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Offline OCR fallback (Tesseract, installed in the Docker image).
OCR_ENABLED=true
OCR_LANGUAGES=eng

# --- Open Food Facts (barcode lookup + alternatives) -------------------------
# Open Food Facts asks apps to identify themselves; include a contact email.
OFF_USER_AGENT=LabelCheck/1.1 (you@example.com)
OFF_TIMEOUT_S=10

# --- Limits --------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_IMAGES=4
RATE_LIMIT_AI_PER_MIN=8
RATE_LIMIT_AI_PER_DAY=60
RATE_LIMIT_VIDEO_PER_MIN=6
RATE_LIMIT_DEFAULT_PER_MIN=120

# Only true behind a proxy that overwrites X-Forwarded-For (docker-compose sets this).
TRUST_PROXY_HEADERS=false

# Comma-separated origins allowed to call the API from other websites/apps.
# Not needed when the web app is served by this server.
CORS_ORIGINS=
